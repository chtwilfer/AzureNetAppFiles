{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "2.0.0.0",
    "parameters": {
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Specifies the location"
            }
        },
        "netappAccountName": {
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "Specifies Account Name"
            }
        },
        "netappPoolName": {
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "Specifies Pool Name"
            }
        },
        "netappPoolSize": {
            "type": "int",
            "minValue": 4398046511104,
            "metadata": {
                "description": "Capacity pool size in bytes; these examples use at least 4 TiB in whole TiB increments"
            }
        },
        "netappVolumeName": {
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "Specifies Volume Name"
            }
        },
        "netappVolumeSize": {
            "type": "int",
            "minValue": 107374182400,
            "metadata": {
                "description": "Volume quota in bytes; at least 100 GiB and no larger than the pool"
            }
        },
        "netappVolumeServicelevel": {
            "type": "string",
            "allowedValues": [
                "Standard",
                "Premium",
                "Ultra"
            ],
            "defaultValue": "Standard",
            "metadata": {
                "description": "Specifies Volume Service Level"
            }
        },
        "netappVolumeProtocol": {
            "type": "string",
            "allowedValues": [
                "NFSv3",
                "NFSv4.1"
            ],
            "metadata": {
                "description": "Specifies Volume Protocol"
            }
        },
        "netappVolumeVirtualNetworkName": {
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "Specifies Virtual NetWork Name"
            }
        },
        "netappVolumeVirtualNetworkSubnetName": {
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "Specifies Virtual Subnet Name"
            }
        },
        "netappVirtualNetworkAddressPrefix": {
            "type": "string",
            "defaultValue": "10.3.0.0/16",
            "metadata": {
                "description": "Specifies Virtual Network Address Prefix"
            }
        },
        "netappVirtualNetworkSubnetAddressPrefix": {
            "type": "string",
            "defaultValue": "10.3.2.0/24",
            "metadata": {
                "description": "Specifies the delegated subnet address prefix"
            }
        },
        "netappAllowedClients": {
            "type": "array",
            "minLength": 1,
            "metadata": {
                "description": "Explicit IPv4 client CIDRs permitted to mount the NFS export"
            }
        },
        "netappAllowRootAccess": {
            "type": "bool",
            "defaultValue": false,
            "metadata": {
                "description": "Allow client root access only when explicitly required"
            }
        }
    },
    "variables": {
    },
    "resources": [
        {
            "type": "Microsoft.NetApp/netAppAccounts",
            "apiVersion": "2026-08-01",
            "name": "[parameters('netappAccountName')]",
            "location": "[parameters('location')]",
            "properties": {}
        },
        {
            "type": "Microsoft.Network/virtualNetworks",
            "apiVersion": "2026-03-01",
            "name": "[parameters('netappVolumeVirtualNetworkName')]",
            "location": "[parameters('location')]",
            "properties": {
                "addressSpace": {
                    "addressPrefixes": [
                        "[parameters('netappVirtualNetworkAddressPrefix')]"
                    ]
                },
                "subnets": [
                    {
                        "name": "[parameters('netappVolumeVirtualNetworkSubnetName')]",
                        "properties": {
                            "addressPrefix": "[parameters('netappVirtualNetworkSubnetAddressPrefix')]",
                            "delegations": [
                                {
                                    "name": "netapp",
                                    "properties": {
                                        "serviceName": "Microsoft.NetApp/volumes"
                                    }
                                }
                            ],
                            "privateEndpointNetworkPolicies": "Enabled",
                            "privateLinkServiceNetworkPolicies": "Enabled"
                        }
                    }
                ]
            }
        },
        {
            "type": "Microsoft.NetApp/netAppAccounts/capacityPools",
            "apiVersion": "2026-08-01",
            "name": "[concat(parameters('netappAccountName'), '/', parameters('netappPoolName'))]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.NetApp/netAppAccounts', parameters('netappAccountName'))]"
            ],
            "properties": {
                "serviceLevel": "[parameters('netappVolumeServicelevel')]",
                "size": "[parameters('netappPoolSize')]"
            }
        },
        {
            "name": "[concat(parameters('netappAccountName'),'/', parameters('netappPoolName'), '/',parameters('netappVolumeName'))]",
            "apiVersion": "2026-08-01",
            "type": "Microsoft.NetApp/netAppAccounts/capacityPools/volumes",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.NetApp/netAppAccounts/capacityPools', parameters('netappAccountName'), parameters('netappPoolName'))]",
                "[resourceId('Microsoft.Network/virtualNetworks', parameters('netappVolumeVirtualNetworkName'))]"
            ],
            "properties": {
                "serviceLevel": "[parameters('netappVolumeServicelevel')]",
                "usageThreshold": "[parameters('netappVolumeSize')]",
                "creationToken": "[parameters('netappVolumeName')]",
                "subnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('netappVolumeVirtualNetworkName'), parameters('netappVolumeVirtualNetworkSubnetName'))]",
                "protocolTypes": [ "[parameters('netappVolumeProtocol')]" ],
                "exportPolicy": {
                    "rules": [
                        {
                            "allowedClients": "[join(parameters('netappAllowedClients'), ',')]",
                            "nfsv3": "[equals(parameters('netappVolumeProtocol'), 'NFSv3')]",
                            "nfsv41": "[equals(parameters('netappVolumeProtocol'), 'NFSv4.1')]",
                            "ruleIndex": 1,
                            "unixReadOnly": false,
                            "unixReadWrite": true,
                            "kerberos5ReadOnly": false,
                            "kerberos5ReadWrite": false,
                            "kerberos5iReadOnly": false,
                            "kerberos5iReadWrite": false,
                            "kerberos5pReadOnly": false,
                            "kerberos5pReadWrite": false,
                            "hasRootAccess": "[parameters('netappAllowRootAccess')]"
                        }
                    ]
                }
            }
        }
    ],
    "outputs": {
        "accountId": {
            "type": "string",
            "value": "[resourceId('Microsoft.NetApp/netAppAccounts', parameters('netappAccountName'))]"
        },
        "poolId": {
            "type": "string",
            "value": "[resourceId('Microsoft.NetApp/netAppAccounts/capacityPools', parameters('netappAccountName'), parameters('netappPoolName'))]"
        },
        "volumeId": {
            "type": "string",
            "value": "[resourceId('Microsoft.NetApp/netAppAccounts/capacityPools/volumes', parameters('netappAccountName'), parameters('netappPoolName'), parameters('netappVolumeName'))]"
        },
        "subnetId": {
            "type": "string",
            "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('netappVolumeVirtualNetworkName'), parameters('netappVolumeVirtualNetworkSubnetName'))]"
        }
    }
}
